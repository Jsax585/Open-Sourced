// Provider-wire compat for "minimax-code-cn"; regenerated from the frozen census using deployment contract selectors.

provider "minimax-code-cn" priority=1 {
	default-model "MiniMax-M3"
	env "MINIMAX_CODE_CN_API_KEY"

	// Replaces the provider-id regex in both OpenAI baselines.
	reasoning-deltas-may-be-cumulative #true
	// residue: the legacy lightning SKUs survive only as previous-snapshot rows
	// on the OpenAI-compatible route (models.dev and both live model lists omit
	// them), so they keep that route's effort-mode thinking instead of the
	// Anthropic adaptive rules the rest of the plan uses.
	models "MiniMax-M2.1-lightning" "MiniMax-M2.5-lightning" {
		thinking-mode "effort"
		thinking-effort-map {
			low "low"
			medium "medium"
			high "high"
		}
	}

	kind-apis {
		image "minimax-images"
	}

	// Token Plan keys are valid on the image endpoint; the China plan routes to
	// the canonical domestic host (api.minimaxi.com).
	seed base-url="https://api.minimaxi.com/v1" bundle="always" {
		model "image-01" name="image-01" api="minimax-images" {
			reasoning #false
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits
			supports-tools #false
		}
	}

	models "image-01" {
		kind "image"
	}
}
