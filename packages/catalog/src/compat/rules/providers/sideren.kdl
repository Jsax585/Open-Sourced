// Sideren deployment contract (https://docs.sideren.io; live /v1/models and
// chat probes 2026-10-26).
//
// Sideren is an OpenAI-compatible inference gateway for coding agents at
// https://api.sideren.io/v1 with one bearer key (`sdn_...`). `GET /v1/models`
// is key-protected (401 without a key or with a rejected one) and publishes
// each row's display name, shown context window, output cap, vision/tool flags
// and accepted `reasoning_effort` vocabulary. It also reports, per key, whether
// the key's plan can call the model (`sideren.access.allowed`), so live
// discovery is the deployment truth for that key and same-id rows on other
// hosts must not backfill limits or prices into this provider's rows.
provider "sideren" {
	// On every Sideren plan, the Free plan included, so a new key always has a
	// working default.
	default-model "@sdn/deepseek-v4.1-flash-1017"
	env "SIDEREN_API_KEY"
	dynamic-models-authoritative #true
	skip-cross-provider-reference-fills #true
	discovery label="Sideren"

	// Reviewed snapshot of Sideren's coding roster on the Free through Max
	// plans (the models it lists on models.dev). `/v1/models` needs a key, so
	// generation without credentials bundles these rows; successful runtime
	// discovery replaces them. Usage is billed from the plan's credits rather
	// than a per-token tariff, so seed costs are 0 and pricing status is
	// `included` (below).
	seed api="openai-completions" base-url="https://api.sideren.io/v1" bundle="always" {
		model "@sdn/deepseek-v4.1-flash-1017" name="DeepSeek V4.1 Flash 1017" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=272000 max-tokens=272000
		}
		model "gpt-6-luna" name="GPT-6 Luna" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=272000 max-tokens=128000
		}
		model "@sdn/minimax-m3.1-flash" name="MiniMax M3.1 Flash" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=300000 max-tokens=300000
		}
		model "@sdn/kimi-k2.5" name="Kimi K2.5" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=262144 max-tokens=262144
		}
		model "@sdn/qwen3-coder-next" name="Qwen3 Coder Next" {
			reasoning #false
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=262144 max-tokens=16000
		}
		model "@sdn/minimax-m2.5" name="MiniMax M2.5" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=196608 max-tokens=8192
		}
		model "@sdn/gpt-oss-120b" name="GPT-OSS 120B" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=128000 max-tokens=32768
		}
		model "@sdn/devstral-2-123b" name="Devstral 2 123B" {
			reasoning #false
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=262144 max-tokens=32000
		}
		model "@sdn/glm-5.3" name="GLM 5.3" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=128000
		}
		model "@sdn/glm-5.3-flash" name="GLM 5.3 Flash" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=128000
		}
		model "@sdn/glm-5.2" name="GLM 5.2" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=131072 max-tokens=131072
		}
		model "@sdn/deepseek-v4-pro" name="DeepSeek V4 Pro" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=384000
		}
		model "@sdn/deepseek-v4-flash" name="DeepSeek V4 Flash" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=384000
		}
		model "@sdn/kimi-k2.7-code" name="Kimi K2.7 Code" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=131072 max-tokens=131072
		}
		model "@sdn/qwen3.8-27b" name="Qwen 3.8 27B" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=262144 max-tokens=32768
		}
		model "gpt-6-sol" name="GPT-6 Sol" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=272000 max-tokens=128000
		}
		model "gpt-5.6-terra" name="GPT-5.6 Terra" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=272000 max-tokens=128000
		}
		model "gpt-5.3-codex" name="GPT-5.3 Codex" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=400000 max-tokens=128000
		}
		model "gpt-5.4" name="GPT-5.4" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=272000 max-tokens=128000
		}
		model "gpt-5.4-mini" name="GPT-5.4 mini" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=400000 max-tokens=128000
		}
		model "gemini-3.8-flash" name="Gemini 3.8 Flash" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=65536
		}
		model "mistral-medium-3.5" name="Mistral Medium 3.5" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=256000 max-tokens=209715
		}
		model "gpt-6.1-sol" name="GPT-6.1 Sol" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=272000 max-tokens=128000
		}
		model "gpt-5.6-sol" name="GPT-5.6 Sol" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=272000 max-tokens=128000
		}
		model "grok-4.7" name="Grok 4.7" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=200000 max-tokens=200000
		}
		model "grok-4.6" name="Grok 4.6" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=500000 max-tokens=128000
		}
		model "grok-4.1-fast" name="Grok 4.1 Fast" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=2000000 max-tokens=30000
		}
		model "muse-spark-1.3" name="Muse Spark 1.3" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1048576 max-tokens=131072
		}
		model "muse-wonder-1.0" name="Muse Wonder 1.0" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1048576 max-tokens=131072
		}
		model "gpt-6-astra" name="GPT-6 Astra" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=272000 max-tokens=128000
		}
		model "gpt-5.5" name="GPT-5.5" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=272000 max-tokens=128000
		}
		model "gemini-4-argon" name="Gemini 4 Argon" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1048576 max-tokens=65536
		}
	}

	// Plan-billed: requests draw the account's plan credits, not a published
	// per-token rate.
	pricing-status "included"

	// Sideren's thinking-off value is `reasoning_effort: "none"`, so thinking-off
	// sends `none` instead of clamping to the lowest effort. Live discovery
	// applies the same rule to every row that advertises `none`; these keyless
	// seed rows don't carry the vocabulary, so the rule is spelled out here.
	models "@sdn/deepseek-v4.1-flash-1017" "@sdn/deepseek-v4-pro" "@sdn/deepseek-v4-flash" {
		reasoning-disable-mode "none-effort"
	}

	// Sideren reads Qwen thinking from `reasoning_effort` and ignores Qwen-native
	// `enable_thinking`. Qwen 3.8 27B advertises low/medium/xhigh and no off
	// value (`none` still reasons, live 2026-10-26), so thinking-off sends its
	// lowest effort.
	class "qwen" {
		thinking-format "openai"
		reasoning-disable-mode "lowest-effort"
	}
	models "@sdn/qwen3.8-27b" {
		thinking-efforts "low" "medium" "xhigh"
	}

	// Sideren serves GPT-5.4 with a 272K window (its `/v1/models` row), so the
	// class-wide 1M window patch and uncapped long-context window do not apply.
	class "openai" {
		models "gpt-5.4" {
			limits-patch {}
			long-context-window-uncapped #false
		}
	}

	// Gateway request dialect: plain Chat Completions. The gateway accepts
	// `developer`, `store` and `max_completion_tokens` (verified 2026-10-26)
	// but translates per upstream, so send the portable shapes.
	supports-developer-role #false
	supports-store #false
	max-tokens-field "max_tokens"
}
